{
  "name": "@fireflyframework/koinon-mcp-desktop",
  "version": "26.10.0-alpha.1",
  "private": true,
  "description": "Branded desktop bridge for the firefly koinon remote MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "validate": "mcpb validate build/manifest.json",
    "package": "npm run typecheck && npm test && npm run validate && python3 scripts/package.py",
    "smoke": "tsx --test test/relocation.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "26.0.0",
    "esbuild": "0.28.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  }
}
