# Replace every SET_FROM_SECRET_STORE value. This file is a template, never a usable deployment.
KOINON_DATABASE_URL=SET_FROM_SECRET_STORE
KOINON_CANON_DATABASE_URL=SET_FROM_SECRET_STORE
KOINON_CANON_ADMIN_DATABASE_URL=SET_FROM_SECRET_STORE
KOINON_STRUCTURED_DATABASE_URL=SET_FROM_SECRET_STORE
KOINON_STRUCTURED_ADMIN_DATABASE_URL=SET_FROM_SECRET_STORE
KOINON_MASTER_KEY=SET_FROM_SECRET_STORE
KOINON_IDENTITY_MASTER_KEY=SET_FROM_SECRET_STORE
KOINON_ASSISTANTS_ALLOWED_PROVIDER_HOSTS=[]
KOINON_SCHEMA_POLICY=validate
KOINON_CACHE_ENABLED=true
KOINON_CACHE_PROVIDER=postgres
KOINON_CACHE_DATASOURCE=primary
KOINON_LEGACY_ENABLED=false
KOINON_OIDC_PROVIDER=keycloak
KOINON_OIDC_ISSUER=https://identity.example/realms/organization
KOINON_OIDC_CLIENT_ID=SET_FROM_IDENTITY_CONFIGURATION
KOINON_OIDC_CLIENT_SECRET=SET_FROM_SECRET_STORE
KOINON_OIDC_API_AUDIENCE=SET_FROM_IDENTITY_CONFIGURATION
KOINON_OIDC_REDIRECT_URI=https://knowledge.example/login/oauth2/code/koinon
KOINON_FRONTEND_URI=/
KOINON_COOKIE_SECURE=true
# No KOINON_MIGRATION_DATABASE_URL belongs in a running API service.

# Optional cloud storage. Install backend storage-azure or storage-gcs first.
# Repeat the chosen provider fields for DOCUMENT, STRUCTURED and ATTACHMENT.
# Prefixes isolate domains; these comments do not migrate retained local data.
# KOINON_DOCUMENT_STORAGE_BACKEND=azure
# KOINON_DOCUMENT_STORAGE_AZURE_ACCOUNT_URL=https://your-account.blob.core.windows.net
# KOINON_DOCUMENT_STORAGE_AZURE_CONTAINER=your-existing-private-container
# KOINON_DOCUMENT_STORAGE_AZURE_PREFIX=koinon/documents
# KOINON_STRUCTURED_STORAGE_BACKEND=azure
# KOINON_STRUCTURED_STORAGE_AZURE_ACCOUNT_URL=https://your-account.blob.core.windows.net
# KOINON_STRUCTURED_STORAGE_AZURE_CONTAINER=your-existing-private-container
# KOINON_STRUCTURED_STORAGE_AZURE_PREFIX=koinon/structured
# KOINON_ATTACHMENT_STORAGE_BACKEND=azure
# KOINON_ATTACHMENT_STORAGE_AZURE_ACCOUNT_URL=https://your-account.blob.core.windows.net
# KOINON_ATTACHMENT_STORAGE_AZURE_CONTAINER=your-existing-private-container
# KOINON_ATTACHMENT_STORAGE_AZURE_PREFIX=koinon/private-attachments
# Alternative GCS profile (use instead of the Azure selection):
# KOINON_DOCUMENT_STORAGE_BACKEND=gcs
# KOINON_DOCUMENT_STORAGE_GCS_BUCKET=your-existing-private-bucket
# KOINON_DOCUMENT_STORAGE_GCS_PROJECT=your-project
# KOINON_DOCUMENT_STORAGE_GCS_PREFIX=koinon/documents
# KOINON_STRUCTURED_STORAGE_BACKEND=gcs
# KOINON_STRUCTURED_STORAGE_GCS_BUCKET=your-existing-private-bucket
# KOINON_STRUCTURED_STORAGE_GCS_PROJECT=your-project
# KOINON_STRUCTURED_STORAGE_GCS_PREFIX=koinon/structured
# KOINON_ATTACHMENT_STORAGE_BACKEND=gcs
# KOINON_ATTACHMENT_STORAGE_GCS_BUCKET=your-existing-private-bucket
# KOINON_ATTACHMENT_STORAGE_GCS_PROJECT=your-project
# KOINON_ATTACHMENT_STORAGE_GCS_PREFIX=koinon/private-attachments
# Optional per-domain bounds (also available for DOCUMENT and ATTACHMENT):
# KOINON_STRUCTURED_STORAGE_REQUEST_TIMEOUT_SECONDS=10
# KOINON_STRUCTURED_STORAGE_MAX_OBJECT_BYTES=67108864
# KOINON_STRUCTURED_STORAGE_GCS_ENDPOINT_URL=http://127.0.0.1:4443
# Workload/application-default credentials are supplied outside this file.
