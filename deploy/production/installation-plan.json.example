{
  "schema_version": 1,
  "plan_key": "initial-knowledge",
  "tenant_id": "example",
  "providers": [
    {
      "key": "chat",
      "name": "Organization chat",
      "kind": "openai",
      "api": "chat",
      "base_url": "https://chat.example.test/openai/v1",
      "model_ids": [
        "gpt-4o-mini"
      ],
      "secret_env": "INSTALL_CHAT_KEY"
    },
    {
      "key": "embedding",
      "name": "Organization embeddings",
      "kind": "openai",
      "api": "chat",
      "base_url": "https://embeddings.example.test/openai/v1",
      "model_ids": [
        "text-embedding-3-small"
      ],
      "secret_env": "INSTALL_EMBEDDING_KEY"
    }
  ],
  "catalog": [],
  "connections": [
    {
      "key": "documents-answer",
      "role": "documents.answer",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "documents-consolidation",
      "role": "documents.consolidation",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "documents-rlm",
      "role": "documents.rlm",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-grounding",
      "role": "structured.grounding",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-generation",
      "role": "structured.generation",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-critic",
      "role": "structured.critic",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-explainer",
      "role": "structured.explainer",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-describe",
      "role": "structured.describe",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-relation_proposal",
      "role": "structured.relation_proposal",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    },
    {
      "key": "structured-rename_detection",
      "role": "structured.rename_detection",
      "provider_key": "chat",
      "model_id": "gpt-4o-mini"
    }
  ],
  "indexes": [],
  "agent": {
    "key": "knowledge-guide",
    "name": "Knowledge guide",
    "provider_key": "chat",
    "model_id": "gpt-4o-mini",
    "tools": [
      "search_knowledge",
      "inspect_schema",
      "query_dataset"
    ],
    "set_default_if_empty": true
  }
}
