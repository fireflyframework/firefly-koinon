[Unit]
Description=firefly koinon headless API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koinon
Group=koinon
WorkingDirectory=/opt/koinon/backend
EnvironmentFile=/etc/koinon/runtime.env
ExecStart=/opt/koinon/backend/.venv/bin/python -m uvicorn koinon.main:app --host 127.0.0.1 --port 18781 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/koinon

[Install]
WantedBy=multi-user.target
