[Unit]
Description=firefly koinon headless API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koinon
Group=koinon
WorkingDirectory=/opt/koinon/backend
Environment=PYFLY_SERVER_HOST=127.0.0.1
Environment=PYFLY_SERVER_PORT=18781
Environment=PYFLY_SERVER_TYPE=uvicorn
EnvironmentFile=/etc/koinon/runtime.env
ExecStart=/usr/bin/env FORWARDED_ALLOW_IPS=127.0.0.1 /opt/koinon/backend/.venv/bin/python -m koinon.serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/koinon

[Install]
WantedBy=multi-user.target
