[Unit]
Description=firefly koinon complete background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koinon
Group=koinon
WorkingDirectory=/opt/koinon/backend
EnvironmentFile=/etc/koinon/runtime.env
Environment=KOINON_PROCESS_ROLE=worker
ExecStart=/opt/koinon/backend/.venv/bin/python -m koinon.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/koinon

[Install]
WantedBy=multi-user.target
