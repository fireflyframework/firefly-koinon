{
  "name": "firefly-koinon-workspace",
  "version": "26.10.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve management",
    "build": "ng build koinon-angular && ng build management && ng build elements",
    "watch": "ng build --watch --configuration development",
    "test": "ng test koinon-angular --watch=false && ng test management --watch=false",
    "lint": "ng lint",
    "typecheck": "npm run sync:locale && ng build koinon-angular --configuration development && ng build management --configuration development",
    "test:e2e": "playwright test",
    "screenshots": "playwright test e2e/visual.spec.ts",
    "sync:brand": "node scripts/sync-brand.mjs",
    "prebuild": "npm run sync:brand && npm run sync:locale",
    "pretest": "npm run sync:brand && npm run sync:locale",
    "prestart": "npm run build:library",
    "preview": "node scripts/preview.mjs",
    "smoke:consumer": "npm run build && node scripts/smoke-consumer.mjs",
    "build:library": "npm run sync:brand && npm run sync:locale && ng build koinon-angular",
    "build:catalog": "npm run build:library && ng build catalog",
    "sync:locale": "node scripts/sync-workbench-locale.mjs",
    "check:locale": "node scripts/sync-workbench-locale.mjs --check",
    "check:bundle": "node scripts/check-initial-bundle.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.3",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fireflyframework/koinon-sdk": "file:../sdk/typescript",
    "@fontsource-variable/manrope": "^5.3.0",
    "@openuidev/angular-lang": "^0.4.2",
    "@openuidev/lang-core": "^0.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "author": "Firefly Software Foundation"
}
