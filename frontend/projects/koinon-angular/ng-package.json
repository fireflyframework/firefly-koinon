{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/koinon-angular",
  "allowedNonPeerDependencies": ["lowlight"],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": ".brand",
      "output": "assets/brand"
    },
    {
      "glob": "LICENSE",
      "input": ".legal",
      "output": "."
    },
    {
      "glob": "NOTICE",
      "input": ".legal",
      "output": "."
    }
  ]
}
