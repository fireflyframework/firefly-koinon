/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "@fireflyframework/koinon-angular/activity": ["./dist/koinon-angular/activity"],
      "@fireflyframework/koinon-angular/activity/window": ["./dist/koinon-angular/activity/window"],
      "@fireflyframework/koinon-angular/communications/email-preview": ["./dist/koinon-angular/communications/email-preview"],
      "@fireflyframework/koinon-angular/communications/preferences": ["./dist/koinon-angular/communications/preferences"],
      "@fireflyframework/koinon-angular/communications/runtime": ["./dist/koinon-angular/communications/runtime"],
      "@fireflyframework/koinon-sdk/communications": ["../sdk/typescript/dist/communications"],
      "@fireflyframework/koinon-sdk": ["../sdk/typescript/dist"],
      "@fireflyframework/koinon-angular/communications/schedule": ["./dist/koinon-angular/communications/schedule"],
      "@fireflyframework/koinon-angular": ["./dist/koinon-angular"],
      "@fireflyframework/koinon-angular/workbench": ["./dist/koinon-angular/workbench"],
      "@fireflyframework/koinon-angular/chat": ["./dist/koinon-angular/chat"],
      "@fireflyframework/koinon-angular/chat/page": ["./dist/koinon-angular/chat/page"],
      "@fireflyframework/koinon-angular/chat/evidence": ["./dist/koinon-angular/chat/evidence"],
      "@fireflyframework/koinon-angular/settings": ["./dist/koinon-angular/settings"],
      "@fireflyframework/koinon-angular/communications": ["./dist/koinon-angular/communications"],
      "@fireflyframework/koinon-angular/communications/invitations": [
        "./dist/koinon-angular/communications/invitations"
      ],
      "@fireflyframework/koinon-angular/communications/inbox": [
        "./dist/koinon-angular/communications/inbox"
      ],
      "@fireflyframework/koinon-angular/communications/admin": [
        "./dist/koinon-angular/communications/admin"
      ]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/management/tsconfig.app.json"
    },
    {
      "path": "./projects/management/tsconfig.spec.json"
    },
    {
      "path": "./projects/koinon-angular/tsconfig.lib.json"
    },
    {
      "path": "./projects/koinon-angular/tsconfig.spec.json"
    },
    {
      "path": "./projects/elements/tsconfig.app.json"
    }
  ]
}
